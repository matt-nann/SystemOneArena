# Copy to .env and fill in. server/server.js reads it on start; real env vars win.

# One OpenRouter key serves both players (same as Aven).
OPENROUTER_API_KEY=sk-or-...

# Jev: TypeSafe's System One model, through OpenRouter's Decisions endpoint (alpha).
JEV_MODEL=typesafe/jev-1.13
# OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
# JEV_TIMEOUT_SECONDS=20

# Sol: any OpenRouter chat model that supports structured outputs (json_schema).
# Check the exact slug at https://openrouter.ai/models before the first live run.
SOL_MODEL=openai/gpt-6-sol
# OpenRouter reasoning.effort: low / medium / high. Empty sends nothing (model default).
SOL_REASONING_EFFORT=
# SOL_MAX_TOKENS=4000
# SOL_TIMEOUT_SECONDS=60

# Display names on the nameplates.
# JEV_NAME=Jev
# SOL_NAME=Sol

# Dry run (`npm run dry`): no network, canned answers after these delays.
# JEV_DRY_RUN_MS=350
# SOL_DRY_RUN_MS=6000

# PORT=8787
