# Copy to .env. The arena reads it on start; real environment variables win.
# The OpenRouter names match Aven's packages/llm, so the same values work there.

# One OpenRouter key serves both players.
OPENROUTER_API_KEY=sk-or-...

# Mock every OpenRouter request in-process (no key needed, nothing leaves the machine).
OPENROUTER_MOCK=false

# Or run `python -m mock_openrouter` and point any OpenRouter client at it:
# OPENROUTER_BASE_URL=http://localhost:8790/api/v1
# OPENROUTER_DECISIONS_URL=http://localhost:8790/api/alpha/decisions

# Jev: TypeSafe's System One model, through OpenRouter's Decisions endpoint (alpha).
JEV_MODEL=typesafe/jev-1.13
# JEV_TIMEOUT_SECONDS=20

# Sol: any OpenRouter chat model with structured outputs. Check the exact slug on openrouter.ai/models.
SOL_MODEL=openai/gpt-6-sol
# OpenRouter reasoning.effort: low / medium / high. Empty sends nothing.
SOL_REASONING_EFFORT=
# SOL_MAX_TOKENS=4000
# SOL_TIMEOUT_SECONDS=60

# JEV_NAME=Jev
# SOL_NAME=Sol

# MATCH_SECONDS=60
# MATCH_SEED=13

# Required in any deployment: starting a match then needs ?admin=<token> in the viewer URL.
ARENA_ADMIN_TOKEN=
# PORT=8000
# LOG_DIR=logs

# ── Mock OpenRouter (MOCK_*), used by OPENROUTER_MOCK=true and `python -m mock_openrouter` ──
# Latency per endpoint for any model without its own profile.
# MOCK_DECISIONS_LATENCY_MS=350
# MOCK_DECISIONS_JITTER_MS=120
# MOCK_CHAT_LATENCY_MS=6000
# MOCK_CHAT_JITTER_MS=1500
# Fraction of calls that fail (HTTP 502), to exercise error handling.
# MOCK_ERROR_RATE=0
# How the mock picks moves: playbook | first | random | wait
# MOCK_STRATEGY=playbook
# Per-model overrides as JSON:
# MOCK_PROFILES={"openai/gpt-6-sol": {"latency_ms": 2500, "jitter_ms": 500, "error_rate": 0.05, "error": "timeout"}}
# MOCK_SEED=7
# MOCK_PORT=8790
